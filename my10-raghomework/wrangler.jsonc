{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "second-brain-agent",
	"main": "worker/index.ts",
	"compatibility_date": "2026-05-15",
	"assets": {
		"not_found_handling": "single-page-application"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	"ai": {
		"binding": "AI",
		"remote": true
	},
	"browser": {
		"binding": "MYBROWSER"
	},
	"durable_objects": {
		"bindings": [
			{
				"class_name": "SecondBrainAgent",
				"name": "SecondBrainAgent"
			}
		]
	},
	"migrations": [
		{
			"new_sqlite_classes": [
				"SecondBrainAgent"
			],
			"tag": "1"
		}
	],
	"vectorize": [
		{
			"binding": "VECTORIZE",
			"index_name": "second-brain-index",
			"remote": true
		}
	]
}
